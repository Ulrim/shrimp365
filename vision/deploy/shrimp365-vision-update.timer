[Unit]
Description=Shrimp365 vision 원격 업데이트 확인(1시간마다)

[Timer]
# 부팅 직후에 한 번 본다. 꺼 두었던 장비가 켜지면 바로 따라잡게 하려는 것이다.
# 5분을 두는 것은 그 전에 카메라와 네트워크가 자리를 잡게 하려는 것.
OnBootSec=5min

# 센서 파이는 5분마다 본다 — 웹에서 "업데이트" 를 누른 뒤 기다리지 않게 하려고.
# 비전 파이에는 그 버튼이 없다(목록에 올리는 것이 곧 승인이다). 급히 받아야 할
# 이유가 없고, 확인마다 목록을 내려받으므로 1시간이면 충분하다.
OnUnitActiveSec=1h

# 전 농가가 같은 순간에 몰리지 않도록 기기마다 흩뜨린다. 장비가 열 대를 넘고
# 늘어날 예정이라, 정각마다 한꺼번에 몰리면 서버도 농장 회선도 손해다.
RandomizedDelaySec=10min

# 꺼져 있던 동안 지나간 차례는 켜질 때 한 번 몰아서 돈다.
Persistent=true

[Install]
WantedBy=timers.target
