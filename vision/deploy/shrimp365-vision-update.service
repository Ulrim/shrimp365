[Unit]
Description=Shrimp365 vision 원격 업데이트 확인
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# 구버전 설치본에 타이머만 붙은 장비에서 매시간 파이썬 오류를 쌓지 않는다.
ConditionPathExists=/opt/shrimp365-vision/deploy/updater.py
# root 여야 한다 — /opt 의 설치본을 바꾸고 서비스를 재시작한다.
# 서명을 통과한 꾸러미만 여기까지 온다(deploy/updater.py 머리말 참고).
ExecStart=/usr/bin/python3 /opt/shrimp365-vision/deploy/updater.py

# 한 번 도는 데 오래 걸릴 수 있다 — 내려받기 + 재시작 후 2분간 건강 확인.
# 상한이 없으면 회선이 늘어질 때 영영 물려 있는다.
TimeoutStartSec=15min

# 추론에 양보한다. 문법 검사 두 번과 /opt 통째 복사가 파이 4 에서 CPU·IO 를
# 다투면 그동안 개체수가 느려진다 — 업데이트는 급할 것이 없다.
Nice=10
IOSchedulingClass=idle

# 로그 메시지가 한글이다.
Environment=LANG=C.UTF-8
Environment=PYTHONIOENCODING=utf-8

StandardOutput=journal
StandardError=journal
