[Unit]
Description=Shrimp365 vision service (개체수 모니터링)
Documentation=https://www.shrimp365.kr/guide
After=network-online.target
Wants=network-online.target

# 카메라 케이블이 빠지거나 인터넷이 끊겨도 프로세스는 계속 살아 있어야 한다.
# 재시작 폭주를 막기 위한 상한(수질 센서 서비스와 같은 정책).
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/opt/shrimp365-vision
ExecStart=/opt/shrimp365-vision/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
EnvironmentFile=/etc/shrimp365-vision/env
Restart=always
RestartSec=15

# video 그룹이 있어야 CSI 카메라(/dev/video*, /dev/media*)에 닿는다.
User=shrimp365
Group=video

# 로그 메시지가 한글이다. 서비스는 로케일이 비어 있는 상태로 뜨므로
# 인코딩을 명시하지 않으면 journalctl 에서 한글이 깨질 수 있다.
Environment=LANG=C.UTF-8
Environment=PYTHONIOENCODING=utf-8

# 추론이 4코어를 다 먹으면 같은 파이에서 도는 수질 센서 수집이 밀린다.
# 우선순위를 낮춰 센서 쪽을 먼저 보낸다 — 개체수는 1초 늦어도 되지만
# 센서 값은 타이밍이 어긋나면 기록이 비뚤어진다.
Nice=10
CPUWeight=50

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/shrimp365-vision/ai/models
StateDirectory=shrimp365-vision

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
