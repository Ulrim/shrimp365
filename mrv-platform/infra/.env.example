# 컬리버 MRV 플랫폼 환경변수 예시.
# 실제 값은 infra/.env 로 복사해 채우고, .env 는 커밋하지 않는다(CLAUDE Rule 7).

# --- Database (TimescaleDB / PostgreSQL) ---
# ★ADR 0007 5절(D5): DB 역할은 **두 개**이며 용도가 다르다. 섞어 쓰면 RLS 가 무력화된다.
#
#   (1) POSTGRES_USER  = 소유자 / 마이그레이션 전용.
#       공식 postgres·timescaledb 이미지는 이 역할을 `initdb --username=` 으로 만드는데
#       그 결과는 **부트스트랩 superuser** 이고, Postgres 는 superuser 에게 RLS 를 아예
#       적용하지 않는다(FORCE ROW LEVEL SECURITY 는 *소유자*에게만 적용된다).
#       실측: superuser 로 `SELECT count(*) FROM tanks`(org 컨텍스트 없음) → 전체 행이 보인다.
#       CREATE TABLE / CREATE POLICY / create_hypertable 에 필요하므로 유지하되,
#       **런타임 앱은 절대 이 역할로 접속하지 않는다.**
#
#   (2) APP_DB_USER    = 런타임(api/worker/ingestion) 전용, NOSUPERUSER NOBYPASSRLS.
#       infra/db/init/10_app_role.sh 가 최초 기동 시 생성하고, ALTER DEFAULT PRIVILEGES 로
#       "마이그레이션이 나중에 만들 테이블/시퀀스"에까지 DML 권한을 예약한다.
#       실측: 이 역할로 `SELECT count(*) FROM tanks`(org 컨텍스트 없음) → 0행(RLS 작동).
POSTGRES_USER=culiver
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=culiver

# 런타임 앱 역할. 비밀번호는 반드시 채워야 한다(init 스크립트가 비어 있으면 기동 실패시킨다 —
# 하드코딩 폴백을 두지 않는다, CLAUDE Rule 7).
APP_DB_USER=culiver_app
APP_DB_PASSWORD=change-me-app-password

# api/worker 컨테이너의 DATABASE_URL(= 런타임 역할). production 에서 이 역할이 superuser
# 이거나 BYPASSRLS 이면 app/config.py::assert_non_superuser_db_role 이 기동을 막는다.
APP_DATABASE_URL=postgresql+psycopg://culiver_app:change-me-app-password@db:5432/culiver

# alembic 전용 URL(= 소유자 역할). api 컨테이너 기동 명령의 마이그레이션 단계와
# `make migrate` 만 이 값을 쓴다. 애플리케이션 프로세스에는 주입되지 않는다.
MIGRATION_DATABASE_URL=postgresql+psycopg://culiver:change-me-strong-password@db:5432/culiver

# 로컬(도커 밖) 개발 폴백. 컨테이너에서는 위 APP_DATABASE_URL 이 이 값을 덮어쓴다.
# 주의: 개발 편의로 여기에 superuser URL 을 넣으면 RLS 가 검증되지 않는다(경고 로그가 뜬다).
DATABASE_URL=postgresql+psycopg://culiver_app:change-me-app-password@db:5432/culiver

# --- Auth (JWT, 대칭키 HS256) ---
JWT_SECRET=change-me-32byte-random-secret
JWT_ALGORITHM=HS256

# --- Auth mode (Phase 3 슬라이스 O, ADR 0005 / ADR 0006) ---
# test-local | supabase. production 환경에서는 supabase 가 필수(설정 로드 시점에 강제 —
# test-local 이 운영에 노출되는 것을 물리적으로 차단, app/config.py::_guard_production_auth_mode).
AUTH_MODE=test-local
# Supabase 프로젝트 설정 > API > JWT Secret. AUTH_MODE=supabase 일 때 필수.
# ★ADR 0006: shrimp365(www.shrimp365.kr)와 "동일한" Supabase 프로젝트의 JWT Secret 을 넣는다.
#   이 값이 같아야 shrimp365 로 발급된 토큰을 culiver 가 검증할 수 있다(= 계정 공유의 실체).
#   주의: 레거시 HS256 공유 비밀이어야 한다(비대칭 Signing Key 로 전환된 프로젝트라면
#   ADR 0005 1절 마이그레이션 트리거 발동 — 코드 착수 전 확인 필요).
SUPABASE_JWT_SECRET=
# 참고용(백엔드 코드는 사용하지 않음). ★ADR 0006 6절: 이 값이 있어도 백엔드는 Supabase
#   Postgres 에 접속하지 않는다 — culiver 업무 데이터는 DATABASE_URL(자체 TimescaleDB) 전용.
#   즉 위 DATABASE_URL 에 Supabase DB 연결 문자열을 넣는 것은 ADR 0006 1절 위반이다.
SUPABASE_URL=

# --- App ---
APP_NAME=culiver-mrv-api
ENVIRONMENT=development

# --- MQTT (ingestion, Phase 1) ---
MQTT_HOST=mqtt
MQTT_PORT=1883

# --- MRV 리포트(Phase 3) ---
# PDF 산출물 저장 경로(컨테이너 내부 경로). 슬라이스 M(MRV 리포트) 구현 시 사용.
MRV_REPORTS_DIR=/app/var/mrv-reports

# --- CORS(Phase 3, 8.4절) ---
# FE 배포 도메인만 콤마구분으로 명시(와일드카드 * 금지 — Bearer 토큰 응답 데이터 유출 방지).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- 로깅(Phase 3, 8.2절) ---
LOG_LEVEL=INFO

# --- API 문서(Phase 3, 8.6절) ---
# 운영에서 /docs, /redoc 노출을 끄고 싶으면 false 로 설정(기본 true — 인증이 최종 방어선).
ENABLE_DOCS=true
