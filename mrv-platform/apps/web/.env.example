# 백엔드 API base URL (예: http://localhost:8000). 커밋 금지 값은 .env 로.
VITE_API_BASE=http://localhost:8000
# 스프린트 0 데모 사이트 ID
VITE_DEMO_SITE_ID=demo-site

# --- Supabase Auth (ADR 0005 / ADR 0006) ---
# Supabase 프로젝트 설정 > API에서 확인. anon key는 클라이언트 노출 전제(공개 가능한 값,
# RLS/서버 검증이 실제 방어선) — 그래도 프로젝트별 값이므로 커밋 금지, .env 로 관리.
# ★ADR 0006: shrimp365(www.shrimp365.kr)와 동일한 Supabase 프로젝트 값을 넣는다
#   (계정 공유의 실체). 데이터 평면은 공유하지 않는다 — culiver FE는 Supabase의
#   .from()/.rpc()/.storage 등을 절대 사용하지 않으며 supabase-client.guard.test.ts가 강제한다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- 미초대 계정 안내 문의 경로 (ADR 0006 4절, FED-3) ---
# 이메일 주소 또는 https URL. 비워 두면 문의 링크를 렌더하지 않고 일반 안내 문구만 보여준다
# (값 없을 때 깨진 링크를 노출하지 않는다 — shrimp365 진입 버튼과 동일한 원칙).
VITE_SUPPORT_CONTACT=
