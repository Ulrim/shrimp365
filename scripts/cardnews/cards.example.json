    "cover": "label(12자) / title(배열=줄단위, 줄당 6~8자, 2줄) / subtitle(20자)",
    "point": "index / label(8자) / value(8자, 등폭) / caption(22자) / valueStyle: 'text'면 문장으로 크게",
    "outro": "title(배열) / rows([라벨, 값] 6행 이내) / ctaTitle / ctaNote / ctaUrl"
  },

