# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright / screenshots / generated artifacts
.playwright-mcp/
.shots/
*.png
*.jpeg
*.jpg
# 카드뉴스 이미지는 사이트가 서빙하는 실제 콘텐츠이므로 저장소에 포함한다
!public/cardnews/**/*.png
# 앱 아이콘(파비콘·PWA)도 빌드 산출물이 아니라 소스다
!public/icons/*.png
!app/apple-icon.png
# .claude 내부는 무시하되, 공유 스킬만 저장소에 포함
# (세션마다 새로 clone되므로 스킬은 커밋 필요)
.claude/*
!.claude/skills/
