# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# 업데이트 서명 개인키만 예외로 저장소에 포함한다(단일 운영자·비공개 저장소 전제).
# 저장소를 공개로 바꾸면 이 키는 폐기하고 새로 만들 것.
!raspberry-pi/secrets/release-key.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright / screenshots / generated artifacts
.playwright-mcp/
.shots/
*.png
*.jpeg
*.jpg
# 카드뉴스 이미지는 사이트가 서빙하는 실제 콘텐츠이므로 저장소에 포함한다
!public/cardnews/**/*.png
# 앱 아이콘(파비콘·PWA)도 빌드 산출물이 아니라 소스다
!public/icons/*.png
!app/apple-icon.png
# 지원사업 점검용 첨부 이미지 — 제출 서류에 그대로 들어가는 자료다
!docs/**/assets/*.png
# .claude 내부는 무시하되, 공유 스킬·에이전트만 저장소에 포함
# (세션마다 새로 clone되므로 스킬과 팀 정의는 커밋 필요)
.claude/*
!.claude/skills/
!.claude/agents/

# Python
__pycache__/
*.pyc

# 라즈베리파이 터치스크린 미리보기 — make-preview.py 로 생성하는 빌드 산출물
/kiosk-preview.html
