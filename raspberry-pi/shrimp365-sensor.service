[Unit]
Description=Shrimp365 water quality sensor collector
Documentation=https://www.shrimp365.kr/guide
After=network-online.target
Wants=network-online.target

# 센서 선이 빠지거나 인터넷이 끊겨도 프로세스는 계속 살아 있어야 한다.
# 재시작 폭주를 막기 위한 상한. (이 두 항목은 [Unit] 에 있어야 적용된다)
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/opt/shrimp365
ExecStart=/usr/bin/python3 /opt/shrimp365/shrimp365_sensor.py --config /etc/shrimp365/config.ini
Restart=always
RestartSec=15
User=shrimp365
Group=dialout

# 로그 메시지가 한글이다. 서비스는 로케일이 비어 있는 상태로 뜨므로
# 인코딩을 명시하지 않으면 journalctl 에서 한글이 깨질 수 있다.
Environment=LANG=C.UTF-8
Environment=PYTHONIOENCODING=utf-8

# 필요한 것 외에는 접근하지 못하게 한다.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# 오프라인 보관 DB 를 두는 곳. systemd 가 만들고 권한을 준다.
StateDirectory=shrimp365
ReadWritePaths=/var/log /etc/shrimp365

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
