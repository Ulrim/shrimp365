[Unit]
Description=Shrimp365 sensor agent update check (daily)

[Timer]
# 하루 한 번이면 충분하다. 급한 수정이 있으면 오너가 SSH 로 바로 실행할 수 있다.
OnCalendar=daily

# 부팅 직후에는 회선이 아직 안 붙었을 수 있으니 조금 기다린다.
OnBootSec=15min

# 전 농가가 같은 시각에 몰리면 서버도, 회선도 한꺼번에 부담을 받는다.
# 기기마다 최대 6시간을 무작위로 늦춘다.
RandomizedDelaySec=6h

# 정전 등으로 못 돌고 지나간 회차는 다음 부팅 때 한 번 채운다.
Persistent=true

[Install]
WantedBy=timers.target
