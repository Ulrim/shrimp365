# Supabase — https://supabase.com/dashboard/project/<project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (server-only, never expose to browser)
# Required for IoT sensor data ingestion API (/api/sensors/data)
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude AI — https://console.anthropic.com/
# Optional: enables real AI responses in the AI Advisor page
ANTHROPIC_API_KEY=

# Set to "true" to show test account buttons on the login page (dev/staging only)
NEXT_PUBLIC_SHOW_TEST_ACCOUNTS=

# Production site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Paddle Billing — https://vendors.paddle.com
# PADDLE_ENV: "production" or "sandbox" (use sandbox for testing)
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# Paddle price IDs (from Paddle dashboard → Catalog → Prices)
PADDLE_BASIC_PRICE_ID=pri_
PADDLE_PRO_PRICE_ID=pri_

# Client-side token (Paddle dashboard → Developer Tools → Authentication)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Client-side price IDs (same values as above — needed for frontend checkout)
NEXT_PUBLIC_PADDLE_BASIC_PRICE_ID=pri_
NEXT_PUBLIC_PADDLE_PRO_PRICE_ID=pri_
