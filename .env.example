# Supabase — https://supabase.com/dashboard/project/<project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (server-only, never expose to browser)
# Required for: IoT sensor ingestion (/api/sensors/data), admin stats, account deletion
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI GPT — https://platform.openai.com/api-keys
# 선택 — AI_BASE_URL 미설정 시 대안. AI 어드바이저가 gpt-4o-mini 로 답변
# (둘 다 없으면 규칙 기반 답변으로 자동 폴백)
OPENAI_API_KEY=

# AI 어드바이저 — 공개 오픈웨이트 모델 (OpenAI 호환 서버). 설정 시 OPENAI_API_KEY 보다 우선.
# AI_MODEL 기본값(route.ts)은 Ollama용 태그라, Vercel 등 호스팅 API에서는 AI_MODEL을 반드시 함께 설정할 것.
#
# ─ 권장(1순위): Groq — 가입만으로 무료(카드 불필요), 모델당 하루 약 1,000요청.
#   공개(오픈웨이트) 모델을 초고속 서빙. 키 발급: console.groq.com
#   한도는 모델별로 다르니 가입 후 console.groq.com/docs/rate-limits 에서 확인.
# AI_BASE_URL=https://api.groq.com/openai/v1
#   ⚠ 모델 ID 는 제공자가 수시로 바꾸고 폐기한다. 아래는 예시일 뿐이며,
#     넣기 전에 /api/admin/ai-diag (오너 전용) 로 이 계정에서 실제로 쓸 수 있는
#     모델 목록을 확인할 것. 없는 이름을 넣으면 404 로 실패해 규칙 답변만 나간다.
# AI_MODEL=llama-3.3-70b-versatile
# AI_API_KEY=gsk_...
#
# ─ 2순위: OpenRouter — :free 모델은 무과금 계정 기준 하루 50요청.
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=deepseek/deepseek-chat-v3.1:free    # 대안: z-ai/glm-4.5-air:free
# AI_API_KEY=sk-or-v1-...
#
# ─ NAS/로컬 도커(선택): docker compose --profile ai up -d 후 (NAS-DEPLOY.md 9절)
# AI_BASE_URL=http://ollama:11434/v1
# AI_MODEL=qwen3:4b-instruct-2507-q4_K_M
# AI_API_KEY=ollama    # Ollama는 키를 검증하지 않음(더미)
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# 2차(폴백) AI 백엔드 — 1차(AI_BASE_URL)가 한도 소진(429)·장애·타임아웃일 때
# 같은 요청 안에서 자동 전환된다. 미설정 시 이 단계는 건너뛴다.
# 2차까지 실패하면 내장 규칙 기반 답변으로 폴백(사용자에게 500 없음).
#   예 (a) OpenRouter :free — 가입만으로 무료, 하루 50회. 1차(Groq) 소진 후 완충용.
#     AI_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
#     AI_FALLBACK_MODEL=deepseek/deepseek-chat-v3.1:free
#     AI_FALLBACK_API_KEY=sk-or-v1-...
#   예 (b) NAS Ollama + Cloudflare Tunnel 공개 주소(끝에 /v1) — 자체 장비, 호출 한도 없음.
#     Ollama는 무인증이므로 Cloudflare Access 보호 필수. 속도는 CPU 추론 수준.
AI_FALLBACK_BASE_URL=
AI_FALLBACK_MODEL=
AI_FALLBACK_API_KEY=

# 웹푸시(VAPID) — 앱을 닫은 뒤에도 위험 알림을 받으려면 필요하다.
# 셋 중 하나라도 비어 있으면 서버 푸시는 조용히 꺼지고, 알림은 기존 인탭 방식
# (브라우저 탭이 열려 있을 때만 뜸)으로 폴백한다. 즉 이 값 없이도 앱은 정상 동작한다.
#
# 키 생성 (한 번만 만들어 두고 계속 쓴다. 키를 바꾸면 기존 구독이 전부 무효가 된다):
#   npx web-push generate-vapid-keys
#
#   Public Key  → NEXT_PUBLIC_VAPID_PUBLIC_KEY (브라우저가 구독할 때 쓰므로 공개돼도 무방)
#   Private Key → VAPID_PRIVATE_KEY            (서버 전용. 절대 NEXT_PUBLIC_ 로 두지 말 것)
#
# VAPID_SUBJECT 는 푸시 서비스가 문제 생겼을 때 연락할 곳이다. mailto: 또는 https: 주소.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@culiver.ai

# Production site URL (no trailing slash) — used for auth email links, sitemap, hreflang
NEXT_PUBLIC_SITE_URL=https://www.shrimp365.kr

# Show test-account login buttons. MUST be unset/false in production.
NEXT_PUBLIC_SHOW_TEST_ACCOUNTS=

# Google AdSense publisher ID (e.g. ca-pub-XXXXXXXXXXXXXXXX).
# Ads render only when this is set. Leave blank to disable ads.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Google Analytics 4 측정 ID (예: G-XXXXXXXXXX).
# 코드에 기본값(G-463S4HVXZ1)이 있어 미설정 시 기본 ID로 동작.
# 다른 GA 속성으로 바꾸려면 여기에 해당 측정 ID를 입력.
NEXT_PUBLIC_GA_ID=

# Naver 로그인 (커스텀 OAuth) — https://developers.naver.com/apps
# 네이버 개발자센터에서 애플리케이션 등록 후 발급. Callback URL 등록: {SITE_URL}/auth/naver/callback
# '회원이름/이메일' 항목을 필수 제공으로 설정해야 로그인 시 이메일을 받을 수 있음.
# (Google·Kakao는 Supabase 대시보드 Authentication → Providers 에서 설정하며 별도 env 불필요)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 카카오 로그인 요청 동의범위(scope). 기본값은 닉네임만("profile_nickname").
# 비즈앱 전환 + 이메일 동의항목 승인 후에는 "profile_nickname account_email"로 설정하면
# 이메일까지 받습니다. (기본값이 있어 미설정 시 닉네임만 요청 → KOE205 방지)
NEXT_PUBLIC_KAKAO_SCOPES=

# ─── 컬리버 탄소 MRV 플랫폼 (/mrv) ───────────────────────────────────────────
# 플랫폼은 이 앱 안(/mrv)에서 돌아가므로 아래 두 값은 모두 선택 사항이다.
#
# 스키마는 supabase/migrations/mrv_platform.sql 을 Supabase SQL Editor 에서 한 번
# 실행해 만든다. 데이터 접근은 서버 라우트가 SUPABASE_SERVICE_ROLE_KEY 로 하므로
# MRV 전용 키는 따로 없다.

# 진입 버튼이 가리킬 주소. 비워 두면 기본값 "/mrv"(이 앱 내부)를 쓴다.
# 별도 도메인에 따로 배포했다면 절대 URL(예: https://mrv.culiver.co.kr)을 넣는다.
# 빈 문자열을 명시적으로 넣고 싶으면 lib/features.ts 의 기본값을 손대야 한다.
NEXT_PUBLIC_MRV_PLATFORM_URL=

# 초대되지 않은 계정에게 보여 줄 문의 경로(이메일 또는 https URL).
# 비워 두면 링크 없이 안내 문구만 나온다 — 깨진 링크를 실서비스에 노출하지 않는다.
NEXT_PUBLIC_MRV_SUPPORT_CONTACT=

# 알림 배치(/api/mrv/jobs/evaluate-alerts)를 부를 때 쓰는 비밀값. 서버 전용.
# 이 창구는 전 조직의 사이트를 평가하므로 사람 세션이 아니라 이 값으로만 연다.
# ★ 비워 두면 창구가 503 으로 닫힌 채로 있고 알림이 생성되지 않는다 —
#   설정을 깜빡한 배포에서 인증 없는 창구가 열려 있는 것보다 낫다고 판단했다.
# Vercel Cron 은 이 값을 Authorization: Bearer 로 자동으로 붙여 준다(vercel.json 참고).
# 값은 충분히 긴 난수로: openssl rand -hex 32
CRON_SECRET=

# Sentry error monitoring — https://sentry.io
# DSN is public (expose to browser). Auth token + org/project are CI-only for source map uploads.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
