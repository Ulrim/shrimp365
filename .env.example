# Supabase — https://supabase.com/dashboard/project/<project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (server-only, never expose to browser)
# Required for IoT sensor data ingestion API (/api/sensors/data)
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI GPT — https://platform.openai.com/api-keys
# Optional: enables real AI responses in the AI Advisor page
OPENAI_API_KEY=

# Set to "true" to show test account buttons on the login page (dev/staging only)
NEXT_PUBLIC_SHOW_TEST_ACCOUNTS=

# Production site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# DODO Payments — https://dashboard.dodopayments.com
# DODO_PAYMENTS_ENVIRONMENT: "live_mode" or "test_mode"
DODO_PAYMENTS_ENVIRONMENT=live_mode
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_SECRET=
